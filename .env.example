# Database
DATABASE_URL="postgresql://travel_admin:password@localhost:5432/travel_photo_blog"

# ============================================
# TRAVEL PHOTO BLOG - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git!

# ============================================
# APP CONFIGURATION
# ============================================
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================
# DATABASE (Required)
# ============================================
# Use Supabase or local PostgreSQL
# 
# Supabase (Recommended):
#   - Get from: Project Settings → Database → Connection String
#   - Use "Connection Pooling" for production (better for serverless)
#   - Use "Direct Connection" for local development
# 
# Local PostgreSQL example:
#   postgresql://postgres:password@localhost:5432/travel_photo_blog
#
# Supabase example (pooled):
#   postgresql://postgres.xxxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://user:password@localhost:5432/travel_photo_blog"

# ============================================
# SUPABASE (Optional - for storage)
# ============================================
# Get from: Project Settings → API
# 
# SUPABASE_URL: Your project's API URL
# SUPABASE_ANON_KEY: Public anon key (safe to expose)
# SUPABASE_SERVICE_ROLE: Service role key (KEEP SECRET!)
#
# If using UploadThing instead, you can skip these
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# AUTHENTICATION (Required)
# ============================================
# NEXTAUTH_SECRET: Generate with: openssl rand -base64 32
# NEXTAUTH_URL: Your app's URL (update for production)
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# ============================================
# GOOGLE OAUTH (Optional but Recommended)
# ============================================
# Setup: https://console.cloud.google.com
# 1. Create project or select existing
# 2. Enable Google+ API
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Add authorized origins:
#    - http://localhost:3000
#    - https://YOUR_PRODUCTION_DOMAIN
# 5. Add authorized redirect URIs:
#    - http://localhost:3000/api/auth/callback/google
#    - https://YOUR_PRODUCTION_DOMAIN/api/auth/callback/google
#
# Leave blank to disable Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret-here

# ============================================
# EMAIL AUTHENTICATION (Optional)
# ============================================
# Choose ONE method: SMTP or Resend
# Leave both blank to disable email authentication

# --- Option A: SMTP (e.g., Gmail) ---
# Gmail example:
#   1. Enable 2-Factor Authentication
#   2. Generate App Password (Google Account → Security → App passwords)
#   3. Use format: smtp://email:app-password@smtp.gmail.com:587
#
# SMTP_URL format: smtp://USERNAME:PASSWORD@HOST:PORT
SMTP_URL=smtp://your-email@gmail.com:your-app-password@smtp.gmail.com:587
EMAIL_FROM=noreply@yourdomain.com

# --- Option B: Resend (Recommended for production) ---
# Setup: https://resend.com
#   1. Sign up (free tier: 3,000 emails/month)
#   2. Add and verify your domain
#   3. Create API key
#
# If using Resend, comment out SMTP_URL above
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=noreply@yourdomain.com

# ============================================
# IMAGE UPLOAD (Required)
# ============================================
# UploadThing: https://uploadthing.com
# 1. Sign up (free tier: 2GB storage, 25GB bandwidth/month)
# 2. Create new app
# 3. Get credentials from API Keys tab
#
# Handles image uploads, optimization, and CDN delivery
UPLOADTHING_SECRET=your_uploadthing_secret_key_here
UPLOADTHING_APP_ID=your_uploadthing_app_id_here

# ============================================
# ADMIN ACCESS (Required)
# ============================================
# Comma-separated list of email addresses that have admin access
# These users can access /admin and manage content
# Use the email you'll sign in with
#
# Examples:
#   Single admin: admin@example.com
#   Multiple:     admin@example.com,editor@example.com
ADMIN_EMAILS=your-email@example.com

# ============================================
# OPTIONAL: EDITOR ACCESS
# ============================================
# Comma-separated list of email addresses that have editor access
# Editors can manage content but not access admin settings
# EDITOR_EMAILS=editor1@example.com,editor2@example.com

# ============================================
# DEVELOPMENT OPTIONS
# ============================================
# Enable detailed logging
# DEBUG=false

# Disable email sending in development (logs to console instead)
# EMAIL_PREVIEW_MODE=true

# ============================================
# PRODUCTION-ONLY SETTINGS
# ============================================
# Uncomment and configure when deploying to production

# Production domain (update NEXTAUTH_URL and Google OAuth callbacks)
# NEXTAUTH_URL=https://yourdomain.com

# Use Supabase pooled connection for serverless
# DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres?pgbouncer=true

# Enable analytics/monitoring
# NEXT_PUBLIC_ANALYTICS_ID=xxxxx

# Sentry error tracking
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ============================================
# NOTES
# ============================================
# - All REQUIRED variables must be set for the app to work
# - OPTIONAL variables enable additional features
# - Never commit .env.local to version control
# - Use different values for development and production
# - Keep SUPABASE_SERVICE_ROLE and NEXTAUTH_SECRET secret!
# - Update callback URLs when deploying to production

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# UploadThing
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# Email (for passwordless auth)
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="noreply@example.com"
